---
import { content } from '../data/content';
import { localPath } from '../lib/paths';
---
<header class="site-header wrap">
 <a class="name-link" href={localPath()}> {content.person.name} </a>
 <nav aria-label={content.ui.nav}>{content.navigation.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav>
</header>
